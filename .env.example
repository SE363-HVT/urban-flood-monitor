# Copy this file to .env and fill in your local credentials.
# NEVER commit .env or data/apify_token_pool.json to Git.
#
# Note: Multi-account Apify rotation (Dashboard Panel 7) stores keys locally
# in data/apify_token_pool.json (already gitignored).

APIFY_TOKEN=
UIT_LLM_API_KEY=
YOUTUBE_DATA_API_KEY=
FB_CRAWL_STRATEGY=search
